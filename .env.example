# ---- Frontend (Vite) — PUBLIC values only: anything VITE_-prefixed ships to the browser ----

# Your Convex deployment URL (https://<name>.convex.cloud).
# Local: `npx convex dev` writes it to .env.local for you.
# Production: set it in the Vercel project's Environment Variables, pointing at your PRODUCTION
# Convex deployment (not the dev one).
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Google Analytics measurement ID (optional, currently unused by the app).
VITE_GA_ID=

# ---- Backend secrets — NEVER put these in any .env file or VITE_ variable ----
# They live only in Convex environment variables:
#   npx convex env set ANTHROPIC_API_KEY "<your key>"     # optional: enables official-site discovery
#   npx convex env set ANTHROPIC_MODEL   "<model id>"     # optional: overrides the default extraction model
# The Erasmus Mundus RSS source and link verification need no credentials.
