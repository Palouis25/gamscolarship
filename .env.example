# Convex deployment URL — required for scholarship/opportunity data to load.
# `npx convex dev` creates this automatically in .env.local; copy that value
# here (or into your own .env) for other environments/deployments.
VITE_CONVEX_URL=
# Must be the deployment URL, e.g. https://<name>.convex.cloud
# (NOT the deploy key). On Vercel, `npx convex deploy` sets it automatically.

# Hosting only (Vercel > Settings > Environment Variables), never in a local
# .env and never VITE_-prefixed: the Production deploy key from the Convex
# dashboard (Settings > Deploy keys). Used by the vercel.json buildCommand.
# CONVEX_DEPLOY_KEY=

# Google Analytics measurement ID (optional).
# Leave blank to disable analytics.
VITE_GA_ID=

# --- NOT set here ---
# ADMIN_KEY, GOOGLE_API_KEY, GOOGLE_CSE_ID, and ANTHROPIC_API_KEY are
# server-side secrets for Convex (ingestion + automated discovery). They
# must never be prefixed VITE_ or placed in this file / any frontend env,
# since anything VITE_-prefixed ships to the browser. Set them with:
#   npx convex env set ADMIN_KEY "..."
#   npx convex env set GOOGLE_API_KEY "..."
#   npx convex env set GOOGLE_CSE_ID "..."
#   npx convex env set ANTHROPIC_API_KEY "..."
# See README "Automated discovery" for what each one is for.
